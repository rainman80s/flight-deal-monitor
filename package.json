{
  "name": "flight-deal-monitor",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "wrangler d1 migrations apply flightmon --local",
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply flightmon --local",
    "db:migrate": "wrangler d1 migrations apply flightmon --remote",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261019.1",
    "typescript": "7.0.2",
    "vitest": "4.1.12",
    "wrangler": "4.151.2"
  }
}
