# Copy to .env and fill in. Never commit .env.

# --- Fare search / booking ---
DUFFEL_ACCESS_TOKEN=
IGNAV_API_KEY=

# --- Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+12065550100
# Public HTTPS URL of this server (Twilio calls back here). No trailing slash.
PUBLIC_BASE_URL=https://flights.example.com

# --- People (names must match the [alerts].contacts list in config.toml) ---
CONTACT_RAN_PHONE=+12065550111
CONTACT_BROCK_PHONE=+12065550122

# --- Paths (defaults shown) ---
FLIGHTMON_CONFIG=config.toml
FLIGHTMON_TRAVELERS=travelers.toml
FLIGHTMON_DB=data/flightmon.sqlite3
